# Получите токен у @BotFather. Не добавляйте настоящий токен в Git или в чат.
TELEGRAM_BOT_TOKEN=
# Необязательно: путь к другой проверенной базе знаний.
KNOWLEDGE_BASE_PATH=knowledge/knowledge_base.json
PORT=8000

# ИИ-слой. Без него бот работает на детерминированных правилах базы знаний.
# LLM_PROVIDER=auto  # auto | openai | github | openrouter | groq | deepseek | mistral | gemini | ollama | llm7 | pollinations | custom | off
#
# auto выбирает по порядку:
#   1) ключ конкретного провайдера (GEMINI_API_KEY, GROQ_API_KEY, ...) -> этот провайдер;
#   2) LLM_API_KEY / OPENAI_API_KEY                                  -> OpenAI-совместимый API;
#   3) GH_MODELS_TOKEN / GITHUB_TOKEN                                -> бесплатные GitHub Models;
#   4) иначе                                                          -> бесплатный llm7.io без ключа.
#
# Как подключить свой бесплатный ключ (подробнее в README):
#   Google AI Studio: https://aistudio.google.com/apikey  -> LLM_API_KEY + LLM_PROVIDER=gemini
#   Groq:             https://console.groq.com/keys       -> LLM_API_KEY + LLM_PROVIDER=groq
#   OpenRouter:       https://openrouter.ai/keys          -> LLM_API_KEY + LLM_PROVIDER=openrouter
#   OpenAI:           https://platform.openai.com/api-keys -> LLM_API_KEY (auto выберет сам)
# Модели у провайдеров меняются: точное имя всегда можно задать через LLM_MODEL.
#
# LLM_API_KEY=       # ключ вашего провайдера; в GitHub Actions храните его в secrets
# LLM_BASE_URL=      # корпоративный шлюз или локальная модель: http://127.0.0.1:11434/v1
# LLM_MODEL=         # например gemini-3.5-flash-lite, openai/gpt-oss-20b, gpt-6-luna
# AI_ENABLED=1       # 0 полностью выключает ИИ-слой
#
# Внимание: llm7.io и pollinations — внешние бесплатные шлюзы без SLA. Текст вопроса
# клиента уходит туда. Для рабочей эксплуатации укажите свой ключ или локальную модель.
